{
  "name": "chemi",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["python_workers"],
  "assets": { "directory": "./static" },
  "d1_databases": [
    { "binding": "DB", "database_name": "chemi", "database_id": "463019bc-8dba-4c51-95bc-d9abedaf7937" }
  ],
  // Speech needs R2. Enable R2 in the dashboard, run `npx wrangler r2 bucket create chemi-artifacts`, then uncomment:
  // "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "chemi-artifacts" }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "APP_ENV": "local",
    "OPENAI_BASE_URL": "https://gpt3.shupremium.com/v1",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "observability": { "enabled": true },
  // The zone quangiz.me must be in the same Cloudflare account.
  "routes": [{ "pattern": "chemi.quangiz.me", "custom_domain": true }]
}
