{
  "name": "chemi",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["python_workers"],
  "assets": { "directory": "./static" },
  "d1_databases": [
    // database_id: replace with the id printed by `npx wrangler d1 create chemi`
    { "binding": "DB", "database_name": "chemi", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "chemi-artifacts" }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "APP_ENV": "local",
    "OPENAI_BASE_URL": "https://gpt3.shupremium.com/v1",
    "OPENAI_MODEL": "gpt-4.1-mini"
  },
  "observability": { "enabled": true }
  // Custom domain, after the zone quangiz.me is in your account:
  // "routes": [{ "pattern": "chemi.quangiz.me", "custom_domain": true }]
}
